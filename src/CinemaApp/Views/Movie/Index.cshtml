@model MovieAllIndexViewModel

@{
    ViewData["Title"] = "All Movies";
}

<form asp-controller="Movie" asp-action="Index" method="get" class="mb-4">
    <div class="input-group shadow-sm">
        <input type="text"
               name="SearchQuery"
               class="form-control"
               placeholder="Search by title or director..."
               value="@Model.SearchQuery" />
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> Search
        </button>
        @if (!string.IsNullOrEmpty(Model.SearchQuery))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-light fw-bold">Explore Movies</h1>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary fw-bold shadow-sm">
            <i class="bi bi-arrow-left"></i> Back to Home Page
        </a>
    </div>

    <div class="d-flex flex-column gap-3">
        @if (!Model.Movies.Any())
        {
            <div class="alert alert-warning text-center">
                No movies found matching your search.
            </div>
        }
        else
        {
            @foreach (var movie in Model.Movies)
            {
                <div class="card shadow-lg border-0 rounded-3 d-flex flex-row align-items-center p-2 bg-white"
                     style="height: 140px; max-height: 140px;">

                    <img src="@movie.ImageUrl" class="rounded shadow-sm"
                         alt="@movie.Title"
                         style="width: 100px; height: 125px; object-fit: cover;">

                    <div class="card-body ms-3 p-2 text-dark" style="flex-grow: 1;">
                        <h5 class="fw-bold mb-1 text-primary">@movie.Title</h5>
                        <p class="mb-0" style="font-size: 0.9rem;">
                            <strong>Genre:</strong> @movie.Genre |
                            <strong>Director:</strong> @movie.Director
                        </p>
                        <p class="text-muted mb-0" style="font-size: 0.85rem;">
                            <i class="bi bi-calendar-event"></i> Released: @movie.ReleaseDate
                        </p>
                    </div>

                    <div class="me-3 d-flex gap-2">
                        <a asp-area=""
                           asp-controller="Movie"
                           asp-action="Details"
                           asp-route-id="@movie.Id"
                           class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-eye"></i> Details
                        </a>

                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            @if (movie.IsInUserWatchlist)
                            {
                                <button class="btn btn-success btn-sm rounded-pill px-4 fw-bold shadow-sm" disabled>
                                    <i class="bi bi-check-circle-fill"></i> In Watchlist
                                </button>
                            }
                            else
                            {
                                <a asp-area=""
                                   asp-controller="Watchlist"
                                   asp-action="Add"
                                   asp-route-id="@movie.Id"
                                   class="btn btn-outline-warning btn-sm rounded-pill px-4 fw-bold shadow-sm">
                                    <i class="bi bi-bookmark-plus"></i> Add to Watchlist
                                </a>
                            }
                        }
                    </div>
                </div>
            }
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                @if (Model.PageNumber > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-searchQuery="@Model.SearchQuery">
                            Previous
                        </a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pageNumber="@i"
                           asp-route-searchQuery="@Model.SearchQuery">
                            @i
                        </a>
                    </li>
                }

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-searchQuery="@Model.SearchQuery">
                            Next
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/user.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}